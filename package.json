{
  "name": "lomo-wechat-formal-migration",
  "version": "1.0.0",
  "private": true,
  "description": "LOMO 4.3.7 (com.caike.lomo) → WeChat Mini Game formal engineering migration. FULL CLONE + WECHAT RELEASE dual-profile client, server-authoritative reference backend, asset pipeline, 680-route parity tooling.",
  "scripts": {
    "clean": "rm -rf dist build coverage",
    "build": "tsc -p tsconfig.json",
    "build:release": "node dist/tools/src/build_wechat.js --profile wechat-release",
    "build:full": "node dist/tools/src/build_wechat.js --profile full-clone",
    "build:wechat": "node dist/tools/src/build_wechat.js --profile full-clone && node dist/tools/src/build_wechat.js --profile wechat-release",
    "gen:data": "node dist/tools/src/gen_data.js",
    "gen:assets": "node dist/tools/src/asset_pipeline.js",
    "test": "npm run build && node --test dist/tests/*.js",
    "verify": "node dist/tools/src/verify.js",
    "qa:local": "npm run build && node dist/tools/src/qa_local.js",
    "server": "node dist/server/src/index.js",
    "parity": "node dist/tools/src/route_parity.js",
    "bake:pag": "node dist/tools/src/bake_pag.js",
    "bake:atlas": "npm run build && node dist/tools/src/bake_pag.js --atlas",
    "bake": "npm run build && node dist/tools/src/bake_pag.js",
    "video:pag": "node dist/tools/src/bake_pag.js --video-only",
    "package:server": "node dist/tools/src/package_server.js",
    "cloudrun:readiness": "node dist/tools/src/cloudrun_readiness.js",
    "gen:icon": "node dist/tools/src/gen_icon.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "libpag": "^4.5.85",
    "puppeteer-core": "^25.10.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@cloudbase/js-sdk": "3.9.2",
    "@cloudbase/node-sdk": "^3.18.3",
    "@cloudbase/signature-nodejs": "2.0.0"
  }
}
