{
  "compilerOptions": {
    "target": "ES2019",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2019", "ES2020.Promise"],
    "strict": true,
        "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": false,
    "types": ["node"],
    "rootDir": ".",
    "outDir": "dist"
  },
  "include": [
    "shared/src/**/*.ts",
    "server/src/**/*.ts",
    "client/src/**/*.ts",
    "tools/src/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "server/src/http_type_shim.d.ts"
  ]
}
